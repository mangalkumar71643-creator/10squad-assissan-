{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm run typecheck && pnpm --filter @workspace/game-lobby run build",
  "outputDirectory": "artifacts/game-lobby/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "headers": [
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
