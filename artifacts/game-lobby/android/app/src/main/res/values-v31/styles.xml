<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <!-- Explicitly empty: without this, Android auto-derives a splash
             icon from the adaptive launcher icon, cropping/scaling it
             inconsistently (looks "zoomed" differently each launch) —
             that isn't our actual splash, it's an unwanted OS fallback.
             The real logo display is handled by the web layer. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent</item>
        <item name="windowSplashScreenIconBackgroundColor">#000000</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
