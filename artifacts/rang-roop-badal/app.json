{
  "expo": {
    "name": "Rang Roop Badal",
    "slug": "rang-roop-badal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#160B2E"
    },
    "android": {
      "package": "com.rangroopbadal.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050814"
      }
    },
    "ios": {
      "bundleIdentifier": "com.rangroopbadal.game",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#160B2E"
        }
      ],
      [
        "expo-system-ui",
        {
          "userInterfaceStyle": "dark"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f22e9e32-c1ff-429d-96d8-e82e667508fe"
      }
    },
    "owner": "mangalkumar6494"
  }
}
